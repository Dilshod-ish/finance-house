{
  "extends": "@fincore/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts", "*.config.mjs"]
}
