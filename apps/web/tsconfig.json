{
  "extends": "@fincore/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "*.config.mjs",
    "*.config.ts",
    "e2e/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
