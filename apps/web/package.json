{
  "name": "@fincore/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js App Router shell for the reports",
  "scripts": {
    "build": "next build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "echo \"no unit tests in web; see test:e2e\" && exit 0",
    "test:unit": "echo \"no unit tests in web; see test:e2e\" && exit 0",
    "test:e2e": "playwright test",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000"
  },
  "devDependencies": {
    "@fincore/eslint-config": "workspace:*",
    "@fincore/tsconfig": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.9.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fincore/reports": "workspace:*",
    "@fincore/shared": "workspace:*",
    "@fincore/ui": "workspace:*",
    "next": "15.5.27",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
