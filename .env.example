# Copy to .env.local and adjust. Nothing here is a secret yet.

DATABASE_URL=postgres://fincore:fincore@127.0.0.1:5432/fincore
PORT=3001

# Authentication does not exist yet. With this set, the API reads the tenant
# from the x-fincore-org request header, which trusts the caller completely.
# It is refused outright when NODE_ENV=production — see
# apps/api/src/org-context/resolve.ts.
FINCORE_INSECURE_ORG_HEADER=1

# Browser origins allowed to call the API. Empty disables CORS entirely.
CORS_ORIGINS=http://localhost:3000

# Demo tenants created by `pnpm db:seed`:
#   2f6a1e10-0000-4000-8000-000000000001  (the demo organization)
#   2f6a1e10-0000-4000-8000-000000000002  (a neighbour, to prove RLS)

# --- apps/web -----------------------------------------------------------
# The web app holds no database connection; it reads the API over HTTP.
FINCORE_API_URL=http://127.0.0.1:3001
# Until sign-in exists, the web app reads one organization, named here.
FINCORE_ORG_ID=2f6a1e10-0000-4000-8000-000000000001
