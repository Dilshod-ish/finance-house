{
  "name": "@fincore/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system: tokens, number formatting, report table, the four required states",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components/components.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens.css",
    "src/components/components.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@fincore/eslint-config": "workspace:*",
    "@fincore/tsconfig": "workspace:*",
    "@types/react": "19.2.2",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11"
  },
  "dependencies": {
    "@fincore/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
