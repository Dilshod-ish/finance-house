{
  "name": "@fincore/ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Posting engine. The only package that writes to journal_*",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@fincore/eslint-config": "workspace:*",
    "@fincore/tsconfig": "workspace:*",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "postgres": "3.4.9",
    "@testcontainers/postgresql": "12.1.0",
    "testcontainers": "12.1.0"
  },
  "dependencies": {
    "@fincore/db": "workspace:*",
    "@fincore/shared": "workspace:*",
    "drizzle-orm": "0.45.2"
  }
}
