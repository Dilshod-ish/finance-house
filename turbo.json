{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CORS_ORIGINS",
    "DATABASE_URL",
    "FINCORE_API_URL",
    "FINCORE_INSECURE_ORG_HEADER",
    "FINCORE_ORG_ID",
    "FINCORE_ORG_IDS",
    "FINCORE_WEB_URL",
    "NODE_ENV",
    "PLAYWRIGHT_BROWSERS_PATH",
    "PORT",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}
