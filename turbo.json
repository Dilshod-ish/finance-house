{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "lint": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:unit": { "dependsOn": ["^build"], "outputs": [] },
    "test:integration": { "dependsOn": ["^build"], "outputs": [], "cache": false },
    "coverage": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
